###############################################################################
#                         BALANCEBOX FRONTEND CONFIGURATION
###############################################################################

# Base URL of the BalanceBox backend API (no trailing slash).
#
# Local development:
#   VITE_API_URL=http://localhost:5000
#
# Production (Vercel): set this in
#   Vercel Project -> Settings -> Environment Variables
# for BOTH the "Production" and "Preview" environments, pointing at your
# deployed Render backend, e.g.
#   VITE_API_URL=https://balancebox-backend.onrender.com
#
# NOTE: Vite inlines this value at BUILD time, so you must redeploy after
# changing it. If it is unset, the app falls back to http://localhost:5000,
# which will NOT work for real visitors in production.
VITE_API_URL=http://localhost:5000
