###############################################################################
#                         BALANCEBOX BACKEND CONFIGURATION
###############################################################################

# Port the Express server listens on. Render sets this automatically in
# production — leave it as-is there.
PORT=5000

# MongoDB connection string (Atlas or local). REQUIRED — the server exits on boot
# if this is missing.
# Example: mongodb+srv://<user>:<password>@cluster0.mongodb.net/balancebox
MONGO_URI=

# Secret used to sign JWTs. REQUIRED — the server exits on boot if missing.
# Use a long random string (e.g. `openssl rand -base64 48`) and never reuse the
# development value in production.
JWT_SECRET=

# development | production
# In production, unexpected server errors return a generic message instead of
# the raw error text.
NODE_ENV=development

###############################################################################
#                          EMAIL / OTP  (SendGrid)
###############################################################################

# SendGrid API key with "Mail Send" permission. REQUIRED in production —
# without it the server refuses to send signup codes.
# Create at: SendGrid -> Settings -> API Keys -> Create API Key (Restricted, Mail Send: Full)
SENDGRID_API_KEY=

# The "from" address. MUST be verified in SendGrid first
# (Settings -> Sender Authentication -> Single Sender Verification, or a
# fully authenticated domain). Sending from an unverified address always fails.
SENDGRID_FROM_EMAIL=

# Display name shown in the recipient's inbox.
SENDGRID_FROM_NAME=BalanceBox

# Product name used in the email subject and body.
APP_NAME=BalanceBox

# How long a verification code stays valid (minutes).
OTP_TTL_MINUTES=10

# Minimum wait between "resend code" requests for the same address (seconds).
OTP_RESEND_COOLDOWN_SECONDS=60

# NOTE: In development (NODE_ENV != production) with SENDGRID_API_KEY unset,
# the OTP is printed to the server console instead of being emailed, so the
# flow can be tested without a SendGrid account. This never happens in
# production — the server throws instead.

###############################################################################

# Comma-separated list of browser origins allowed to call this API (CORS).
# Must include your exact Vercel frontend URL in production, with no trailing
# slash. If unset, falls back to the built-in defaults in server.js.
#
# Production value currently set on Render:
#   ALLOWED_ORIGINS=https://balance-box-nine.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
