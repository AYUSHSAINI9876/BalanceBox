###############################################################################
#                         BALANCEBOX BACKEND CONFIGURATION
###############################################################################

# Port the Express server listens on. Render sets this automatically in
# production — leave it as-is there.
PORT=5000

# MongoDB connection string (Atlas or local). REQUIRED — the server exits on boot
# if this is missing.
# Example: mongodb+srv://<user>:<password>@cluster0.mongodb.net/balancebox
MONGO_URI=

# Secret used to sign JWTs. REQUIRED — the server exits on boot if missing.
# Use a long random string (e.g. `openssl rand -base64 48`) and never reuse the
# development value in production.
JWT_SECRET=

# development | production
# In production, unexpected server errors return a generic message instead of
# the raw error text.
NODE_ENV=development

# Comma-separated list of browser origins allowed to call this API (CORS).
# Must include your exact Vercel frontend URL in production, with no trailing
# slash. If unset, falls back to the built-in defaults in server.js.
#
# Production value currently set on Render:
#   ALLOWED_ORIGINS=https://balance-box-nine.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
